{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "description": "Requests per second, excluding /metrics scrapes.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(rate(student_api_http_requests_total[1m]))", "legendFormat": "requests/sec", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 4xx / 5xx Error Rate",
      "description": "Client and server error responses per second.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (status) (rate(student_api_http_requests_total{status=~\"4..|5..\"}[5m]))", "legendFormat": "HTTP {{status}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "P95 HTTP Latency",
      "description": "95th percentile request duration from the Prometheus histogram.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(student_api_http_request_duration_seconds_bucket[5m])))", "legendFormat": "P95", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Prediction Attempts",
      "description": "Successful and failed inference attempts per second.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum by (result) (rate(student_api_predictions_total[5m]))", "legendFormat": "{{result}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Model Loaded",
      "description": "1 = model loaded; 0 = model unavailable.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "student_api_model_loaded", "legendFormat": "model_loaded", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NOT READY", "color": "red" }, "1": { "text": "READY", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Prometheus Target UP",
      "description": "1 = Render /metrics endpoint can be scraped.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "up{job=\"student-result-api\"}", "legendFormat": "target_up", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["mlops", "student-result-prediction", "prometheus"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "Student Result Prediction API",
  "uid": "student-result-api",
  "version": 1
}
